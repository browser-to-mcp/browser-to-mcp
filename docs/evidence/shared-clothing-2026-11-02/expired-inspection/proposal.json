{
  "status": "draft",
  "area": "ul#goods",
  "bindings": {},
  "record": {
    "rows": "li.product-card",
    "fields": {
      "title": {
        "selector": "h3",
        "source": "text"
      },
      "price_text": {
        "selector": ".product-price strong",
        "source": "text"
      },
      "product_url": {
        "selector": ":scope > a",
        "source": "href",
        "path_prefix": "/goods/"
      }
    },
    "unique_by": "product_url",
    "duplicates": "deduplicate"
  },
  "paging": {
    "next_selector": "nav.data-pager a[aria-label=\"Next page\"]",
    "end_selector": "nav.data-pager:has(a[aria-current=\"page\"]):not(:has(a[aria-label=\"Next page\"]))",
    "page_parameter": "page"
  }
}
